# Copy this file to .env and adjust as needed. All values below are placeholders / safe defaults.

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# Optional hosted LLM provider for comparison. Disabled by default; the basic
# prototype never requires this. Not implemented in this version -- see README.
HOSTED_PROVIDER_ENABLED=false
HOSTED_PROVIDER_API_KEY=
HOSTED_PROVIDER_MODEL=

RETRIEVAL_MODE=hybrid_rerank
RERANKER_ENABLED=true

FRONTEND_ORIGIN=http://localhost:5173
